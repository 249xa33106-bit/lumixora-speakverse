generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Identity & Preferences ────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String?   // hashed
  emailVerified DateTime?
  image         String?
  role          String    @default("student") // student | admin | content_editor | content_reviewer | assessment_manager | support_agent
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Auth.js relations
  accounts Account[]
  sessions Session[]

  // SpeakVerse relations
  svProfile          SvProfile?
  svEnrollments      SvEnrollment[]
  svLessonProgress   SvLessonProgress[]
  svActivityAttempts SvActivityAttempt[]
  svSkillEvidence    SvSkillEvidence[]
  svRevisionItems    SvRevisionItem[]
  svSessions         SvSession[]
  svAudioAssets      SvAudioAsset[]
  svConsents         SvConsent[]
  svRoles            SvRole[]
  svFeedbackReports  SvFeedbackReport[]
  svAiUsage          SvAiUsage[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model SvProfile {
  id                  String    @id @default(cuid())
  userId              String    @unique
  displayName         String?
  college             String?
  degree              String?
  targetRole          String?
  learningGoal        String?   // interview | fluency | presentation | internship | workplace
  explanationLanguage String    @default("en") // en | te_en
  dailyGoalMinutes    Int       @default(10)
  targetDate          DateTime?
  onboardingComplete  Boolean   @default(false)
  assessmentComplete  Boolean   @default(false)
  selfAssessedLevel   String?   // A1 | A2 | B1 | B2 | C1
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sv_profiles")
}

model SvUserPreference {
  id                String  @id @default(cuid())
  userId            String  @unique
  captionsDefault   Boolean @default(false)
  audioSpeed        Float   @default(1.0)
  notifications     Boolean @default(true)
  reducedMotion     Boolean @default(false)
  fontSize          String  @default("md") // sm | md | lg
  highContrast      Boolean @default(false)

  @@map("sv_user_preferences")
}

model SvConsent {
  id                String    @id @default(cuid())
  userId            String
  purpose           String    // microphone | recording_retention | data_processing
  privacyVersion    String
  granted           Boolean
  grantedAt         DateTime  @default(now())
  withdrawnAt       DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sv_consents")
}

// ─── Curriculum & Content ──────────────────────────────────────────────────

model SvCourse {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  description String?
  targetLevel String?   // A1 | A2 | B1 | B2 | C1
  status      String    @default("draft") // draft | review | approved | published | retired
  version     Int       @default(1)
  createdBy   String?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  modules     SvModule[]
  enrollments SvEnrollment[]

  @@map("sv_courses")
}

model SvModule {
  id            String  @id @default(cuid())
  courseId      String
  title         String
  description   String?
  position      Int
  prerequisites String? // JSON array of module IDs
  status        String  @default("draft")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  course  SvCourse   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons SvLesson[]

  @@map("sv_modules")
}

model SvLesson {
  id               String    @id @default(cuid())
  moduleId         String
  slug             String
  title            String
  objective        String
  difficulty       String    @default("A1") // A1 | A2 | B1 | B2 | C1
  estimatedMinutes Int       @default(5)
  contentVersion   Int       @default(1)
  status           String    @default("draft")
  skill            String    @default("grammar") // grammar | vocabulary | speaking | listening | writing | interview
  stage            String    @default("foundation") // foundation | everyday | fluency | professional | interview_excellence
  publishedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  module         SvModule           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  activities     SvActivity[]
  lessonProgress SvLessonProgress[]
  revisions      SvContentRevision[]

  @@unique([moduleId, slug])
  @@map("sv_lessons")
}

model SvActivity {
  id             String  @id @default(cuid())
  lessonId       String
  activityType   String  // sentence_reorder | single_choice | multi_select | fill_blank | error_correction | listening_mcq | dictation | short_writing | spoken_response | conversation_roleplay | presentation | mock_interview | group_discussion
  skill          String
  position       Int
  instructionsI18n String  // JSON: {en: string, te?: string}
  contentJson    String  // JSON: learner-visible content (NO answer keys for protected assessments)
  answerKeyJson  String? // JSON: server-side only answer/rubric data — NEVER sent to client
  scoringConfig  String  // JSON: {maxPoints, hintPenalty, rubricVersion}
  rubricVersion  String  @default("1.0")
  status         String  @default("draft")
  accessibilityJson String? // JSON: {keyboardOperable, audioRequired}
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lesson   SvLesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  attempts SvActivityAttempt[]

  @@map("sv_activities")
}

model SvContentRevision {
  id         String   @id @default(cuid())
  lessonId   String
  version    Int
  changeNote String?
  contentSnapshot String // JSON snapshot
  createdBy  String?
  createdAt  DateTime @default(now())

  lesson SvLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@map("sv_content_revisions")
}

// ─── Learning & Progress ───────────────────────────────────────────────────

model SvEnrollment {
  id         String   @id @default(cuid())
  userId     String
  courseId   String
  enrolledAt DateTime @default(now())
  status     String   @default("active") // active | completed | paused

  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course SvCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@map("sv_enrollments")
}

model SvLessonProgress {
  id                String    @id @default(cuid())
  userId            String
  lessonId          String
  status            String    @default("not_started") // not_started | in_progress | completed
  currentActivityId String?
  completedAt       DateTime?
  lastAccessedAt    DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson SvLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@map("sv_lesson_progress")
}

model SvActivityAttempt {
  id             String   @id @default(cuid())
  idempotencyKey String?  @unique // client-generated for retries
  userId         String
  activityId     String
  contentVersion Int      @default(1)
  responseJson   String   // JSON: learner response
  score          Float?
  maxScore       Float?
  feedbackJson   String?  // JSON: AI/rule feedback
  attemptNumber  Int      @default(1)
  durationSeconds Int?
  hintCount      Int      @default(0)
  createdAt      DateTime @default(now())

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  activity SvActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@map("sv_activity_attempts")
}

model SvSkillEvidence {
  id              String   @id @default(cuid())
  userId          String
  skill           String   // grammar | vocabulary | speaking | listening | writing | interview
  evidenceType    String   // activity_attempt | assessment | session_turn
  sourceAttemptId String?
  rubricVersion   String
  score           Float
  maxScore        Float
  confidence      Float?   // 0-1, from AI or speech provider
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sv_skill_evidence")
}

model SvRevisionItem {
  id                String    @id @default(cuid())
  userId            String
  sourceAttemptId   String?
  skill             String
  revisionContentJson String  // JSON: what to revise
  dueAt             DateTime
  lastReviewedAt    DateTime?
  reviewCount       Int       @default(0)
  status            String    @default("pending") // pending | due | completed
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sv_revision_items")
}

// ─── Conversations & Interview Sessions ───────────────────────────────────

model SvSession {
  id           String    @id @default(cuid())
  userId       String
  sessionType  String    // conversation | mock_interview | group_discussion | assessment | speak_studio
  scenarioId   String?
  targetRole   String?
  difficulty   String    @default("B1")
  inputMode    String    @default("text") // text | voice | mixed
  status       String    @default("active") // active | completed | abandoned
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  rubricVersion String   @default("1.0")

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  turns       SvSessionTurn[]
  audioAssets SvAudioAsset[]
  report      SvSessionReport?

  @@map("sv_sessions")
}

model SvSessionTurn {
  id                   String   @id @default(cuid())
  sessionId            String
  turnNumber           Int
  speaker              String   // user | ai
  transcript           String
  transcriptConfidence Float?   // 0-1 from speech provider
  evaluationJson       String?  // JSON: turn-level evaluation
  createdAt            DateTime @default(now())

  session SvSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("sv_session_turns")
}

model SvAudioAsset {
  id              String    @id @default(cuid())
  userId          String
  sessionId       String?
  storageKey      String    // private storage reference, NOT a public URL
  mimeType        String
  durationMs      Int?
  retentionPolicy String    @default("session") // session | 30_days | explicit_consent
  expiresAt       DateTime?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())

  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  session SvSession? @relation(fields: [sessionId], references: [id])

  @@map("sv_audio_assets")
}

model SvSessionReport {
  id                    String   @id @default(cuid())
  sessionId             String   @unique
  overallSummary        String
  skillScoresJson       String   // JSON: criterion scores
  improvementActionsJson String  // JSON: next steps
  modelVersion          String
  createdAt             DateTime @default(now())

  session SvSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("sv_session_reports")
}

// ─── Administration & Operations ──────────────────────────────────────────

model SvRole {
  id        String   @id @default(cuid())
  userId    String
  role      String   // content_editor | content_reviewer | assessment_manager | support_agent | administrator
  grantedBy String?
  grantedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@map("sv_roles")
}

model SvAuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String   // content_published | role_granted | content_deleted | etc.
  entityType String?
  entityId   String?
  details    String?  // JSON
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@map("sv_audit_logs")
}

model SvAiUsage {
  id           String   @id @default(cuid())
  userId       String?
  provider     String   // gemini | openai
  model        String
  requestType  String   // tutor | evaluation | roleplay | interview | telugu
  inputTokens  Int?
  outputTokens Int?
  audioDurationMs Int?
  latencyMs    Int?
  estimatedCost Float?  // in USD
  outcome      String   // success | error | timeout | rate_limited
  errorCode    String?
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@map("sv_ai_usage")
}

model SvFeedbackReport {
  id          String   @id @default(cuid())
  userId      String
  reportType  String   // inaccurate_feedback | problematic_content | technical_issue
  entityType  String?  // activity | session | lesson
  entityId    String?
  description String
  status      String   @default("open") // open | investigating | resolved | dismissed
  resolvedBy  String?
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sv_feedback_reports")
}
